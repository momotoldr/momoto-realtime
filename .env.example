# ─────────────────────────────────────────────────────────────────────────────
# Two files are read, in precedence order (see src/config/loadEnv.ts):
#   1. `.env.local`  — optional, gitignored, THIS MACHINE ONLY. Wins over `.env`.
#   2. `.env`        — everything else.
# A real environment variable (what the platform injects) beats both.
#
# This service holds NO database, storage, payment or mail credentials — those all live
# in momoto-core. The only secret it shares with core is JWT_SECRET.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP + WebSocket port. 3003 locally (momoto-core is 3001, momoto-notify 3002).
PORT=3003

# How many reverse proxies sit in front of this server (Express `trust proxy`).
# Every per-IP rate limit here (room minting, room lookup, TURN credentials) depends
# on it being right:
#   1 = a single platform proxy (Railway on its own). The default.
#   2 = that platform behind a *proxying* Cloudflare record (orange cloud).
#   0 = no proxy (running the server directly).
# Too low and every user shares one bucket; too high and a client can forge
# X-Forwarded-For to get unlimited buckets. Confirm after deploy by logging req.ip.
TRUST_PROXY=1

# Comma-separated allowlist of frontend origins permitted via CORS (HTTP and the
# Socket.io handshake). Same list as momoto-core's.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Auth ───────────────────────────────────────────────────────────────────
# MUST be identical to momoto-core's JWT_SECRET. Core signs access tokens; this service
# only verifies them on the socket handshake. A mismatch doesn't fail at boot — it fails
# every signed-in handshake as `unauthorized`, while guests keep connecting fine, which
# makes it easy to miss. In production set it by variable reference to core's.
# TODO: Securely load this value from an environment variable or secrets vault. Do not hardcode.
JWT_SECRET=[REDACTED_JWT_SECRET]

# ── Session ────────────────────────────────────────────────────────────────
# Length of a photobooth session, in milliseconds (default 5 minutes).
# Keep equal to the frontend's SESSION_SECONDS (momoto-fe store/useSessionStore). Solo
# rooms never connect here, so the frontend enforces that window on its own and the two
# values have to be matched by hand.
SESSION_DURATION_MS=300000

# Buffer added before a synchronized countdown starts, in milliseconds.
# Gives both clients time to receive the event before the scheduled instant.
START_DELAY_MS=1000

# ── Rooms ──────────────────────────────────────────────────────────────────
# Seats a room is minted with when the creator doesn't ask for a number — every
# solo and date room.
ROOM_CAPACITY=2

# The most seats any one room may be minted with (POST /rooms { capacity }).
# This is the enforcement half of the frontend's VITE_GROUP_MODE_ENABLED: that flag is
# inlined into the public bundle and only decides what the client OFFERS, while this is
# what admits or refuses the third person. Leave at 2 to make group rooms impossible on
# the server; raise to 4 in the same change that turns the frontend flag on.
ROOM_CAPACITY_MAX=2

# Safety valve on live rooms held in memory. Over it, POST /rooms answers
# 503 booth_busy; joining an existing room is never refused. Default 5000.
# ROOMS_MAX_ACTIVE=5000

# Optional: enable the Redis scale path (multi-instance fan-out). See PLAN-redis.md.
# Leave unset for single-instance in-memory state.
# REDIS_URL=redis://localhost:6379

# ── WebRTC ICE servers (served to the FE via GET /turn-credentials) ──────────
# STUN: comma-separated; defaults to Google's public STUN if unset.
# STUN_URLS=stun:stun.l.google.com:19302
#
# TURN: relays media when a direct P2P connection can't be established. The server
# mints time-limited credentials (coturn "TURN REST API" / use-auth-secret), so the
# TURN server must be configured with the SAME shared secret (coturn:
# `use-auth-secret` + `static-auth-secret=<secret>`). Set both to enable TURN.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_STATIC_AUTH_SECRET=[REDACTED_TURN_SHARED_SECRET]
#
# Lifetime of a minted TURN credential, in seconds (default 3600 = 1h).
# TURN_CREDENTIAL_TTL_SECONDS=3600
#
# Cloudflare Realtime TURN (managed, anycast relays). When BOTH are set, Cloudflare is
# the TURN provider and takes precedence over the coturn vars above. Create a TURN app
# at Cloudflare dashboard → Realtime → TURN; copy the Key ID and API Token. The API
# token is a SECRET — store it as a secret env var, never commit it.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=[REDACTED_CLOUDFLARE_TURN_API_TOKEN]
